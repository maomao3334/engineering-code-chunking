    {"id": "e19", "cat": "低价值条款", "q": "违反这个规范会怎么处罚？", "expect": ["1.0.9"], "kuan": 0,
     "note": "命中即证明'正确的废话'会进召回池，需要打价值标签"},
    {"id": "e20", "cat": "口语化", "q": "楼里着火了，人跑不出来，规范对逃生有什么要求？", "expect": ["7.1.2", "7.1.3", "7.1.4", "7.1.8", "7.1.6", "7.4.2", "7.4.4"], "kuan": 0,
     "note": "极口语，考语义鸿沟：用户说'逃跑/禁止'，规范说'疏散'。预期 BM25 失败，用于论证要不要上向量化"}
  ]
}
