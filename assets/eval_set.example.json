{
  "说明": "验收问题集。expect 为可接受的父条号；expect_prefix 表示章级粗判。kuan 为该条应有的款数（用于检查答案是否漏款）。",
  "问题": [
    {"id": "e01", "cat": "多款完整性", "q": "建筑防火的总体目标包含哪几个方面？", "expect": ["2.1.2"], "kuan": 4,
     "note": "4 款缺一即不完整；会上 3 号举的例子"},
    {"id": "e02", "cat": "数字与单位", "q": "消防电梯前室的使用面积最小是多少？", "expect": ["2.2.8"], "kuan": 3,
     "note": "答 6.0m²；款 2"},
    {"id": "e03", "cat": "数字与单位", "q": "消防车道的净宽和净高有什么要求？", "expect": ["3.4.5"], "kuan": 7,
     "note": "7 款，含 4.0m 净宽净高"},
    {"id": "e04", "cat": "直接术语", "q": "甲类厂房的防火间距是多少？", "expect": ["3.2.1"], "kuan": 0,
     "note": "单值条文"},
    {"id": "e05", "cat": "多款完整性", "q": "哪些工业建筑的耐火等级不应低于二级？", "expect": ["5.2.2"], "kuan": 5,
     "note": "5 款列举，漏款即错"},
    {"id": "e06", "cat": "多款完整性", "q": "哪些部位的门应采用甲级防火门？", "expect": ["6.4.2"], "kuan": 5,
     "note": "5 款列举"},
    {"id": "e07", "cat": "情境化", "q": "老年人照料设施的保温材料有什么要求？", "expect": ["6.6.4"], "kuan": 2,
     "note": "注意与 4.3.5（布置）区分，考消歧"},
    {"id": "e08", "cat": "直接术语", "q": "住宅建筑外墙外保温材料的燃烧性能等级怎么确定？", "expect": ["6.6.6"], "kuan": 2,
     "note": "按高度分档 A 级 / B1 级"},
    {"id": "e09", "cat": "表格依赖", "q": "公共建筑什么情况下可以只设一个安全出口？", "expect": ["7.4.1"], "kuan": 2,
     "note": "答案在 表7.4.1，正文不在条文里"},
    {"id": "e10", "cat": "直接术语", "q": "观众厅的疏散门数量和人数有什么关系？", "expect": ["7.4.6"], "kuan": 0,
     "note": "单款，无表格"},
    {"id": "e11", "cat": "多款完整性", "q": "医疗建筑的避难间应该怎么设置？", "expect": ["7.4.8"], "kuan": 4,
     "note": "4 款，含 25.0m² 数字"},
    {"id": "e12", "cat": "多款完整性", "q": "室内消火栓系统设置有哪些要求？", "expect": ["8.1.7"], "kuan": 10,
     "note": "10 款，最长的条之一"},
    {"id": "e13", "cat": "多款完整性", "q": "哪些工业建筑场所应设置自动灭火系统？", "expect": ["8.1.8"], "kuan": 13,
     "note": "13 款，漏款即错"},
    {"id": "e14", "cat": "表格依赖", "q": "消防应急照明的备用电源要能连续供电多长时间？", "expect": ["10.1.4"], "kuan": 0,
     "note": "答案全在 表10.1.4"},
    {"id": "e15", "cat": "数字与单位", "q": "疏散照明的地面最低水平照度是多少？", "expect": ["10.1.10"], "kuan": 3,
     "note": "lx 数值分档"},
    {"id": "e16", "cat": "多款完整性", "q": "施工现场应该采取哪些防火措施？", "expect": ["11.0.1"], "kuan": 4,
     "note": "4 款"},
    {"id": "e17", "cat": "口语化", "q": "小区里的消防车道总被私家车占着，规范管不管这个？", "expect": ["12.0.2", "12.0.6"], "kuan": 0,
